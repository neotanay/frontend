# Development
VITE_API_BASE_URL=/api
# VITE_DEV_API_TARGET=http://127.0.0.1:8000/

# Production
VITE_DEV_API_TARGET=https://cybnp4lpcd.execute-api.us-east-1.amazonaws.com/
VITE_API_TIMEOUT_MS=30000
VITE_APP_TITLE=Safety View - COSMOS

# See .env.example for the full dataset-identifier table -- PT_NAME (this
# app's filterGroupColumns pilot column) lives in SV_Golden_layer_Table_V3.
VITE_QS_DATASET_IDENTIFIER=SV_Golden_layer_Table_V3
VITE_QS_DATASET_IDENTIFIER_URL=https://dq8qzubrypnsg.cloudfront.net/resources/column_dataset_map.json
